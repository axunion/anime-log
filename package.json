{
  "name": "anime-log",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.worker.json",
    "check": "biome check && pnpm typecheck",
    "fix": "biome check --write",
    "gen:favicon": "node scripts/gen-favicon.mjs",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:drop": "drizzle-kit drop",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "wrangler d1 migrations apply anime-db --local",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && pnpm db:migrate",
    "seed:local": "pnpm exec tsx scripts/seed-local.ts",
    "test": "vitest run",
    "test:client": "vitest run --project client",
    "test:server": "vitest run --project server",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@lucide/vue": "^1.47.0",
    "drizzle-orm": "^0.45.3",
    "drizzle-zod": "^0.8.3",
    "hono": "^4.13.8",
    "vue": "^3.5.43",
    "vuedraggable": "^4.1.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@cloudflare/vite-plugin": "^1.56.0",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5",
    "@types/node": "^22.20.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "drizzle-kit": "^0.31.11",
    "happy-dom": "^20.14.5",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.0",
    "vitest": "^4",
    "vue-tsc": "^3.3.11",
    "wrangler": "^4.135.0"
  }
}
