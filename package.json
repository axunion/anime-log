{
	"name": "anime-log",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.26.2",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"deploy": "vite build && wrangler deploy",
		"typecheck": "vue-tsc --noEmit",
		"fix": "biome check --write .",
		"migrate:generate": "pnpm exec tsx scripts/migrate.ts",
		"db:migrate": "wrangler d1 migrations apply anime-db --local",
		"db:migrate:remote": "wrangler d1 migrations apply anime-db --remote",
		"test:client": "vitest run --config vitest.config.ts",
		"test:server": "vitest run --config vitest.workers.config.ts",
		"test": "pnpm run test:client && pnpm run test:server",
		"test:watch": "vitest --config vitest.config.ts"
	},
	"dependencies": {
		"hono": "^4.12.18",
		"lucide-vue-next": "^0.468.0",
		"vue": "^3.5.34",
		"vuedraggable": "^4.1.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": [
			"esbuild",
			"workerd",
			"sharp"
		]
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.10",
		"@cloudflare/vite-plugin": "^1.36.3",
		"@cloudflare/vitest-pool-workers": "^0.14.7",
		"@cloudflare/workers-types": "^4.20260510.1",
		"@types/node": "^22.15.3",
		"@vitejs/plugin-vue": "^6.0.5",
		"@vue/test-utils": "^2.4.10",
		"happy-dom": "^20.9.0",
		"tsx": "^4.19.3",
		"typescript": "^5.8.3",
		"vite": "^8.0.11",
		"vitest": "^4.1.4",
		"vue-tsc": "^3.2.6",
		"wrangler": "^4.90.0"
	}
}
